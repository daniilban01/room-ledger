# Copy this file to .env and adjust values. Never commit .env.

# PostgreSQL
POSTGRES_DB=roomledger
POSTGRES_USER=roomledger
POSTGRES_PASSWORD=roomledger

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-chars

# Host port for the frontend (nginx). Change it if 80 is already in use.
FRONTEND_PORT=80
