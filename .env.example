# Copy this file to .env and adjust values. Never commit .env.

# PostgreSQL
POSTGRES_DB=roomledger
POSTGRES_USER=roomledger
POSTGRES_PASSWORD=roomledger

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-chars

# Receipt scanning.
# "dev-fake" returns a demo receipt and needs no API key. To read real receipts set it to "default"
# and fill in the three LLM_* values (any OpenAI-compatible API with image input).
SPRING_PROFILES_ACTIVE=dev-fake
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=
LLM_API_KEY=

# "true" adds the one-click demo: every click creates a private sandbox with sample data
# (sandboxes older than a day are removed every night).
DEMO_ENABLED=false

# Host port for the frontend (nginx). Change it if 80 is already in use.
FRONTEND_PORT=80
