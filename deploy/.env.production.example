# Copy to .env ON THE SERVER (next to docker-compose.prod.yml) and fill in. Never commit the real file.
# Generate secrets on the server with:  openssl rand -base64 32

# Images built by GitHub Actions: ghcr.io/<github-user-lowercase>/roomledger
IMAGE_PREFIX=ghcr.io/your-github-user/roomledger

# Public address. Free option: the server's IP with dashes + .sslip.io, e.g. 18-194-22-33.sslip.io
DOMAIN=

POSTGRES_DB=roomledger
POSTGRES_USER=roomledger
POSTGRES_PASSWORD=

# At least 32 characters; different from your local one.
JWT_SECRET=

# Receipt scanning with a real LLM ("default"), or "dev-fake" for the demo receipt.
SPRING_PROFILES_ACTIVE=default
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=
LLM_API_KEY=

# One-click demo account for recruiters ("Intră în contul demo" on the login page).
DEMO_ENABLED=true
